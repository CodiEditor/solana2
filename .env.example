# Server. Copy to .env for local development; on Vercel set these in the project's environment variables.

# Port the API listens on.
PORT=3000

# Allowed browser origins, comma separated. Use your site's origin in production.
CORS_ORIGIN=http://localhost:5173

# Secret used to sign sign-in tokens. Set a long random value in production.
# If it is empty the server signs with a random secret and sign-ins reset on every restart.
JWT_SECRET=

# Optional key for GET /api/wallets (sent as the x-admin-key header). Leave empty to disable the endpoint.
ADMIN_KEY=

# Postgres for balances, shares and sessions. Vercel's Neon integration sets it. Locally, any Postgres works:
# docker run -d --name aetheros-pg -e POSTGRES_PASSWORD=dev -p 127.0.0.1:5432:5432 postgres:16-alpine
DATABASE_URL=postgres://postgres:dev@127.0.0.1:5432/postgres

# Mining rules. Leave unset to use the defaults shown.
# MINING_DIFFICULTY=5       leading zero hex digits per hash, about 16^5 hashes per share
# CREDITS_PER_SHARE=1       credits added for each accepted share
# DAILY_CREDIT_CAP=1000     credits one wallet can earn per UTC day
# SUBMIT_COOLDOWN_MS=10000  minimum wait between accepted shares for one wallet

# Assistant (assistant.exe). Without a key the assistant is shown as offline and the rest of the app runs.
# Create a key at console.anthropic.com. Keep it out of the repository.
ANTHROPIC_API_KEY=
# Leave unset to use the defaults shown.
# AI_MODEL=claude-haiku-5-5
# AI_PRICE_INPUT_PER_MTOK=0.10     USD per million input tokens, change with AI_MODEL
# AI_PRICE_OUTPUT_PER_MTOK=0.50    USD per million output tokens, change with AI_MODEL
# AI_MONTHLY_BUDGET_USD=50         spend cap for all wallets together, resets on the 1st (UTC)
# AI_MESSAGE_CREDITS=2             credits per chat message
# AI_PROFILE_CREDITS=50            credits per profile built from a dataset
# AI_DAILY_MESSAGES=100            messages per wallet per UTC day
# AI_DAILY_PROFILES=3              profiles per wallet per UTC day
# AI_MIN_WALLET_AGE_HOURS=24       wait after a wallet's first sign-in
# AI_MIN_SOL=0.01                  SOL the wallet must hold on mainnet, only read
# AI_MAX_CONCURRENT=8              assistant calls at once across all wallets
# AI_REQUESTS_PER_MINUTE=30        assistant requests per wallet per minute
# SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
